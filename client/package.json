{
  "name": "ai-os-client",
  "version": "0.1.0",
  "description": "AI-OS Enterprise AI Asset Operating System",
  "author": "桂良涛 <桂良涛@nndrobot.com>",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "npx vite build",
    "package": "npx vite build && npx electron-builder --win",
    "installer": "iscc installer\\setup.iss",
    "release": "npm run package && npm run installer",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vue-tsc": "^2.2.0"
  },
  "build": {
    "appId": "com.nndrobot.ai-os",
    "productName": "AI-OS",
    "compression": "store",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "release-v2"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!node_modules",
      "!src"
    ],
    "extraResources": [
      {
        "from": "backend/python",
        "to": "backend/python"
      },
      {
        "from": "resources/backend/python",
        "to": "resources/backend/python"
      },
      {
        "from": "resources/winsw",
        "to": "winsw"
      }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ]
    }
  }
}
