{
  "name": "ai-os-client",
  "version": "1.0.0",
  "description": "AI-OS Enterprise AI Asset Operating System",
  "author": "桂良涛 <桂良涛@nndrobot.com>",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-build-info.js && npx vite build",
    "package": "node scripts/generate-build-info.js && npx vite build && npx electron-builder --win",
    "pack": "powershell -File scripts/build.ps1",
    "preview": "vite preview"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@types/chart.js": "^2.9.41",
    "chart.js": "^4.5.1",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.1",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.5",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vue-tsc": "^2.2.0"
  },
  "build": {
    "appId": "com.nndrobot.ai-os",
    "productName": "AI-OS",
    "compression": "store",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "D:/ai-os-build5"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!node_modules",
      "!src"
    ],
    "extraResources": [
      {
        "from": "public/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "backend/python",
        "to": "backend/python",
        "filter": ["**/*", "!__pycache__/**", "!**/*.pyc", "!models/bge-m3-onnx-int8/model_quantized.onnx"]
      }
    ],
    "generateUpdatesFilesForAllChannels": false,
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "zh-CN"
      ],
      "language": "2052",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI-OS",
      "uninstallDisplayName": "AI-OS",
      "artifactName": "AI-OS-Setup-${version}.${ext}",
      "include": "installer/installer.nsh"
    }
  }
}
